# MCP Server Configuration
# Copia questo file in .env e personalizza i valori se necessario.

SERVER_NAME="BehavioralPromptsServer"
LOG_LEVEL="INFO" # Livelli: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE="logs/server.log"

# -----------------------------------------------------------------------------
# Brainer STEM Tutor — all settings are prefixed with BRAINER_
# -----------------------------------------------------------------------------

BRAINER_SOLVER_MODEL="gemini-2.5-flash"
BRAINER_TUTOR_MODEL="gemini-2.5-flash"
BRAINER_VISION_MODEL="gemini-3-flash"

# Optional secondary verifier — costs money, on only when confidence is low.
BRAINER_WOLFRAM_ENABLED="false"
BRAINER_WOLFRAM_CONFIDENCE_THRESHOLD="0.6"

# Anti-leak moderator tuning
BRAINER_MODERATOR_MAX_CONSECUTIVE_STEPS="2"
BRAINER_MODERATOR_NUMERIC_TOLERANCE="0.001"

# Follow policy thresholds
BRAINER_POLICY_STUCK_SECONDS="90"
BRAINER_POLICY_FRUSTRATION_THRESHOLD="0.6"

# Live frame detection
BRAINER_LIVE_FRAME_DIFF_THRESHOLD="0.05"
BRAINER_LIVE_STABILITY_FRAMES="2"

BRAINER_LOG_LEVEL="INFO"
BRAINER_LOG_FILE="logs/brainer_tutor.log"
