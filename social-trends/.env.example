# Copy to .env and fill in the keys for the providers you have.
# Every secret is OPTIONAL: a provider without its key reports itself
# unavailable (see `social-trends list-providers`) instead of crashing.

SERVER_NAME="social-trends-mcp"

# --- ScrapeCreators (primary deep-metadata provider; single x-api-key) ---
SCRAPECREATORS_API_KEY=""

# --- Apify (broad scraping actors) ---
APIFY_TOKEN=""

# --- Bright Data (geo / unblocked web) ---
BRIGHTDATA_API_TOKEN=""

# --- Twitch ---
# Real API:
TWITCH_CLIENT_ID=""
TWITCH_APP_TOKEN=""
# Credential-free local mock (`twitch mock-api start`):
TWITCH_USE_MOCK="false"
TWITCH_MOCK_BASE="http://localhost:8080/mock"
